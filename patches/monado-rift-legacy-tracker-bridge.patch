+static bool
+rift_touch_controller_register_legacy_tracker(struct rift_touch_controller *controller)
+{
+	if (controller->input.legacy_tracker_registered || controller->hmd->legacy_tracker == NULL ||
+	    !controller->input.calibration_read) {
+		return controller->input.legacy_tracker_registered;
+	}
+
+	struct rift_touch_controller_calibration *c = &controller->input.calibration;
+	struct rift_legacy_led *leds = U_TYPED_ARRAY_CALLOC(struct rift_legacy_led, c->num_leds);
+	if (leds == NULL) {
+		return false;
+	}
+	for (size_t i = 0; i < c->num_leds; i++) {
+		leds[i].position = c->leds[i].position;
+		leds[i].normal = c->leds[i].normal;
+		leds[i].id = (uint8_t)i;
+		/* Touch LEDs are all-on for every HMD exposure phase. */
+		leds[i].pattern = 0xff;
+	}
+	struct rift_legacy_device_model model = {
+	    .T_imu_device = {.position = c->imu_position, .orientation = XRT_QUAT_IDENTITY},
+	    .leds = leds,
+	    .led_count = c->num_leds,
+	    .accel_offset = c->accel_offset,
+	    .gyro_offset = c->gyro_offset,
+	};
+	memcpy(model.accel_matrix, c->accel_calibration, sizeof(model.accel_matrix));
+	memcpy(model.gyro_matrix, c->gyro_calibration, sizeof(model.gyro_matrix));
+	controller->input.legacy_tracker_registered =
+	    rift_legacy_tracker_add_touch(controller->hmd->legacy_tracker, controller->base.device_type, &model);
+	free(leds);
+	return controller->input.legacy_tracker_registered;
+}
