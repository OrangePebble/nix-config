+static uint16_t
+rift_legacy_pattern_decode(uint32_t sequence)
+{
+	uint16_t pattern = 0;
+	for (uint32_t phase = 0; phase < 10; phase++) {
+		uint32_t state = (sequence >> (phase * 2)) & 0x3;
+		if (state == RIFT_CUSTOM_PATTERN_STAT_HIGH) {
+			pattern |= 1u << phase;
+		}
+	}
+	return pattern;
+}
+
+static bool
+rift_legacy_tracker_read_hmd_patterns(struct rift_hmd *hmd, struct rift_legacy_led *leds)
+{
+	for (size_t i = 0; i < hmd->led_model.led_count; i++) {
+		struct rift_custom_pattern_report pattern = {0};
+		if (rift_get_custom_pattern(hmd, &pattern) < 0 || pattern.sequence_length != 10) {
+			HMD_ERROR(hmd, "Failed to read legacy LED pattern %zu", i);
+			return false;
+		}
+
+		bool found = false;
+		for (size_t j = 0; j < hmd->led_model.led_count; j++) {
+			if (leds[j].id == pattern.led_index) {
+				leds[j].pattern = rift_legacy_pattern_decode(pattern.sequence);
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			HMD_ERROR(hmd, "Legacy LED pattern refers to unknown LED %u", pattern.led_index);
+			return false;
+		}
+	}
+	return true;
+}
+
+static struct rift_legacy_tracker *
+rift_legacy_tracker_create_for_hmd(struct rift_hmd *hmd)
+{
+	struct rift_legacy_led *leds = U_TYPED_ARRAY_CALLOC(struct rift_legacy_led, hmd->led_model.led_count);
+	if (leds == NULL) {
+		return NULL;
+	}
+	/* rift_read_led_model converted the factory model into Monado IMU space
+	 * (-Z forward). The vendored tracker consumes the original factory device
+	 * coordinates and an original device-to-IMU offset, just as the full
+	 * legacy backend did. Undo that conversion at this narrow boundary. */
+	struct xrt_pose legacy_imu_device = {
+	    .position = {
+	        hmd->T_imu_device.position.x,
+	        -hmd->T_imu_device.position.y,
+	        hmd->T_imu_device.position.z,
+	    },
+	    .orientation = XRT_QUAT_IDENTITY,
+	};
+	for (size_t i = 0; i < hmd->led_model.led_count; i++) {
+		struct xrt_vec3 relative = {
+		    hmd->led_model.leds[i].position.x - hmd->T_imu_device.position.x,
+		    hmd->led_model.leds[i].position.y - hmd->T_imu_device.position.y,
+		    hmd->led_model.leds[i].position.z - hmd->T_imu_device.position.z,
+		};
+		leds[i].position = (struct xrt_vec3){-relative.x, relative.y, -relative.z};
+		leds[i].normal = (struct xrt_vec3){-hmd->led_model.leds[i].normal.x,
+		                                  hmd->led_model.leds[i].normal.y,
+		                                  -hmd->led_model.leds[i].normal.z};
+		leds[i].id = (uint8_t)hmd->led_model.leds[i].id;
+	}
+	if (!rift_legacy_tracker_read_hmd_patterns(hmd, leds)) {
+		free(leds);
+		return NULL;
+	}
+
+	/* Match the proven full backend: back-strap LEDs articulate with the
+	 * strap and poison the rigid HMD solve. They are behind the headset in
+	 * the legacy factory coordinate system. */
+	size_t legacy_led_count = 0;
+	for (size_t i = 0; i < hmd->led_model.led_count; i++) {
+		if (leds[i].position.z < -0.1f) {
+			continue;
+		}
+		leds[legacy_led_count++] = leds[i];
+	}
+
+	struct rift_legacy_device_model model = {
+	    .T_imu_device = legacy_imu_device,
+	    .leds = leds,
+	    .led_count = legacy_led_count,
+	    .accel_offset = hmd->imu_calibration.accel_offset,
+	    .gyro_offset = hmd->imu_calibration.gyro_offset,
+	};
+	memcpy(model.accel_matrix, &hmd->imu_calibration.accel_matrix, sizeof(model.accel_matrix));
+	memcpy(model.gyro_matrix, &hmd->imu_calibration.gyro_matrix, sizeof(model.gyro_matrix));
+	struct rift_legacy_tracker *tracker = rift_legacy_tracker_create(hmd->radio_address, &model);
+	free(leds);
+	return tracker;
+}
