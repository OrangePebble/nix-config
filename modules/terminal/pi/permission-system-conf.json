{
  "permission": {
    "*": "ask",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "read": "allow",
    "web_crawl": "allow",
    "web_fetch": "allow",
    "web_search": "allow",
    "skill": {
      "*": "allow"
    },
    "path": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pem": "deny",
      "*.pfx": "deny",
      ".envrc": "deny",
      ".netrc": "deny",
      ".zsh_history": "deny",
      "_netrc": "deny",
      "credentials": "deny",
      "id_dsa": "deny",
      "id_ecdsa": "deny",
      "id_ed25519": "deny",
      "id_rsa": "deny",
      "identity": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny"
    },
    "path_read": {
      "*": "allow",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "basename *": "allow",
      "cat *": "allow",
      "date": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "file *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "head *": "allow",
      "nix --version": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "realpath *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "uname *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow"
    },
    "external_directory": {
      "*": "ask"
    },
    "external_directory_read": {
      "/nix/store/*": "allow",
      "~/.config/nvim/*": "allow",
      "~/.config/pi/*": "allow",
      "~/.config/tmux/*": "allow",
      "~/home/nix-config/*": "allow"
    }
  }
}
