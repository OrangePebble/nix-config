{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "*": "ask",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".envrc": "deny",
      ".netrc": "deny",
      "_netrc": "deny",
      "credentials": "deny",
      "id_rsa": "deny",
      "id_ecdsa": "deny",
      "id_ed25519": "deny",
      "id_dsa": "deny",
      "identity": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".zsh_history": "deny",
    },
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "doas *": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "nix --version": "allow",
      "ls": "allow",
      "ls *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "uname": "allow",
      "uname *": "allow",
      // "tree *": "allow",
      // "grep *": "allow",
      // "rg *": "allow",
      // "head *": "allow",
      // "tail *": "allow",
      // "wc *": "allow",
    },
  },
  "default_agent": "ask",
  "agent": {
    "build": { "color": "success" },
    "plan": { "color": "warning" },
    "ask": {
      "description": "Answers questions about the codebase without changing it.",
      "mode": "primary",
      "color": "info",
      "permission": {
        "edit": "deny",
        "task": "deny",
      },
      "prompt": "Answer the user's questions accurately and concisely. Inspect the workspace when relevant; otherwise use your general knowledge. Use read-only shell commands for additional context when needed. When current, niche, or uncertain information is needed, search online using available web tools and cite sources. Do not edit files, launch subagents, or propose implementation steps unless the user asks for them. Cite relevant file paths and line numbers when discussing the workspace.",
    },
  },
}
